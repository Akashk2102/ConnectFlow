# ConnectFlow Environment Configuration
APP_NAME=ConnectFlow
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change_this_to_a_secure_random_key_in_production_32_chars_min

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL - Stage 3)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=connectflow_db

# Redis Configuration (Stage 10)
REDIS_URL=redis://localhost:6379/0

# Communication Provider Configuration (Plivo - Stage 6)
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_PHONE_NUMBER=+1234567890

# LLM Configuration (Stage 7)
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gemini-2.5-flash
